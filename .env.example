# Copy to .env. Never commit real secrets.
POSTGRES_DB=sqlcopilot
POSTGRES_USER=sqlcopilot
POSTGRES_PASSWORD=change_me_to_a_local_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sqlcopilot:change_me_to_a_local_dev_password@db:5432/sqlcopilot
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CREDENTIAL_ENCRYPTION_KEY=
COOKIE_SECURE=false
ALLOW_PRIVATE_DATABASE_HOSTS=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TEST_DATABASE_URL=
# Optional disposable PostgreSQL database used by integration tests.
# Never point integration tests at production data.
